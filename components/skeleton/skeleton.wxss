.skeleton {
  padding: 24rpx;
}

/* 闪光动画 */
@keyframes shine {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton-shine {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shine 1.5s infinite;
  border-radius: 8rpx;
}

/* 卡片骨架 */
.skeleton-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.skeleton-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 24rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}

.skeleton-line.short {
  height: 20rpx;
}

.skeleton-content {
  margin-bottom: 24rpx;
}

.skeleton-footer {
  display: flex;
  gap: 12rpx;
}

.skeleton-tag {
  width: 120rpx;
  height: 48rpx;
  border-radius: 24rpx;
}

/* 列表骨架 */
.skeleton-list-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}

.skeleton-list-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skeleton-list-content {
  flex: 1;
}

.skeleton-list-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 个人中心骨架 */
.skeleton-profile {
  text-align: center;
  padding: 60rpx 0 40rpx;
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  border-radius: 0 0 40rpx 40rpx;
  margin: -24rpx -24rpx 32rpx;
}

.skeleton-profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: linear-gradient(90deg, rgba(255,255,255,0.3) 25%, rgba(255,255,255,0.5) 50%, rgba(255,255,255,0.3) 75%) !important;
  background-size: 200% 100%;
}

.skeleton-stats {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.skeleton-stat-item {
  flex: 1;
  text-align: center;
}

.skeleton-stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  margin: 0 auto;
}

/* 排行榜骨架 */
.skeleton-podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 24rpx;
  padding: 40rpx 0;
  margin-bottom: 32rpx;
}

.skeleton-podium-item {
  text-align: center;
  flex: 1;
}

.skeleton-podium-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin: 0 auto;
}

.skeleton-podium-bar {
  height: 120rpx;
  border-radius: 16rpx 16rpx 0 0;
  margin-top: 16rpx;
}

.skeleton-rank-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
