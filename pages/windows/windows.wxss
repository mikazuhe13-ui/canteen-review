/* 渐变头部 */
.hero-header {
  position: relative;
  margin: -24rpx -24rpx 32rpx;
  padding: 56rpx 32rpx 48rpx;
  overflow: hidden;
  min-height: 280rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1A0F5E 0%, #2D1B8E 40%, #6C5CE7 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 0;
}

.hero-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 楼层切换 */
.floor-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow-x: auto;
  white-space: nowrap;
}

.floor-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  background: transparent;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.floor-tab-icon {
  font-size: 24rpx;
}

.floor-tab.active {
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  color: #fff;
  font-weight: 600;
}

/* 窗口列表 */
.window-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.window-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.window-card:active {
  transform: scale(0.98) translateY(2rpx);
}

.window-img-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.window-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
}

.window-img-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,0.1));
  border-radius: 24rpx;
}

.window-info {
  flex: 1;
  margin-left: 24rpx;
}

.window-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.window-location-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.location-icon {
  font-size: 20rpx;
}

.window-location {
  font-size: 24rpx;
  color: #999;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.taste-tag {
  font-size: 20rpx;
  color: #6C5CE7;
  background: linear-gradient(135deg, #F0EDFF, #EDE8FF);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.window-rating {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  gap: 10rpx;
}

.rating-badge {
  display: flex;
  align-items: baseline;
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.rating-score {
  font-size: 36rpx;
  font-weight: 800;
  color: #6C5CE7;
}

.rating-star {
  font-size: 22rpx;
  color: #FFB800;
  margin-left: 2rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #999;
}

.dim-bars {
  margin-top: 12rpx;
}

.dim-bar {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.bar-label {
  font-size: 22rpx;
  color: #666;
  width: 60rpx;
}

.bar-track {
  flex: 1;
  height: 10rpx;
  background: #f0f0f0;
  border-radius: 5rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #A78BFA);
  border-radius: 5rpx;
  transition: width 0.5s;
}

.window-arrow {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow-circle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8f8f8, #f0f0f0);
  border-radius: 50%;
  transition: all 0.2s;
}

.window-card:active .arrow-circle {
  background: #f0f0f0;
}

.arrow-icon {
  font-size: 28rpx;
  color: #999;
  transition: color 0.2s;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-emoji {
  font-size: 56rpx;
}

.empty-text-main {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.empty-text-sub {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* Campus comic upgrade */
.container {
  min-height: 100vh;
  padding: 0 24rpx 190rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(22, 119, 255, 0.06) 0 4rpx, transparent 5rpx) 0 330rpx / 34rpx 34rpx,
    linear-gradient(180deg, #FFF8E8 0%, #F7F8FA 430rpx),
    #F7F8FA;
}

.hero-header {
  margin: 0 -24rpx 30rpx;
  min-height: 330rpx;
  padding: 116rpx 32rpx 42rpx;
  box-sizing: border-box;
}

.hero-bg {
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 176, 32, 0.30) 0 58rpx, transparent 60rpx),
    radial-gradient(circle at 18% 26%, rgba(255, 255, 255, 0.18) 0 4rpx, transparent 5rpx) 0 0 / 38rpx 38rpx,
    linear-gradient(135deg, #172033 0%, #245477 58%, #22A06B 100%);
  border-radius: 0 0 34rpx 34rpx;
  border-bottom: 5rpx solid #172033;
}

.hero-bg::after {
  content: '';
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  bottom: 24rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  box-shadow: 0 34rpx 0 rgba(255, 255, 255, 0.13);
}

.hero-badge {
  background: #FFF7E8;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FFB020;
  transform: rotate(-3deg);
}

.badge-text {
  color: #172033;
  font-weight: 900;
}

.hero-title {
  font-size: 52rpx;
  line-height: 1.12;
  color: #FFFFFF;
  text-shadow: 4rpx 4rpx 0 rgba(23, 32, 51, 0.70);
  letter-spacing: 0;
}

.hero-sub {
  font-size: 25rpx;
  font-weight: 700;
}

.floor-tabs {
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 24rpx;
  box-shadow: 7rpx 7rpx 0 #DCE7F5;
  padding: 10rpx;
}

.floor-tab {
  color: #697386;
  font-weight: 800;
}

.floor-tab.active {
  background: #172033;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  box-shadow: 4rpx 4rpx 0 #FFB020;
}

.window-card {
  border: 3rpx solid #172033;
  border-radius: 24rpx;
  box-shadow: 8rpx 8rpx 0 #E5ECF5;
  background:
    radial-gradient(circle at 94% 12%, rgba(255, 176, 32, 0.12) 0 34rpx, transparent 36rpx),
    #FFFFFF;
}

.window-img-wrapper,
.window-img,
.window-img-overlay {
  border-radius: 24rpx;
}

.window-img-wrapper {
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FFE4A8;
}

.window-name {
  color: #172033;
  font-weight: 900;
}

.taste-tag,
.rating-badge {
  border: 2rpx solid #172033;
  background: #FFF7E8;
  color: #8B5E00;
  font-weight: 800;
}

.bar-track {
  border: 2rpx solid #D8DFEA;
  height: 14rpx;
  background: #FFFFFF;
}

.bar-fill {
  background: linear-gradient(90deg, #22A06B, #FFB020);
}

.arrow-circle {
  background: #172033;
  border: 3rpx solid #172033;
  box-shadow: 4rpx 4rpx 0 #FFB020;
}

.arrow-icon {
  color: #FFFFFF;
  font-weight: 900;
}

/* Pop art layer */
.hero-bg {
  background:
    radial-gradient(circle at 84% 18%, rgba(255, 79, 184, 0.34) 0 54rpx, transparent 56rpx),
    radial-gradient(circle at 18% 26%, rgba(255, 225, 77, 0.26) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    linear-gradient(135deg, #172033 0%, #245477 58%, #00C2FF 100%);
}

.hero-title {
  text-shadow: 4rpx 4rpx 0 #FF4FB8, 7rpx 7rpx 0 rgba(255, 225, 77, 0.38);
}

.window-card {
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(0, 194, 255, 0.10) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    #FFFFFF;
}

.rating-badge,
.taste-tag,
.floor-tab.active,
.arrow-circle {
  box-shadow: 4rpx 4rpx 0 #FF4FB8;
}

.hero-burst {
  right: 26rpx;
  bottom: 38rpx;
}

.hero-chip {
  right: 110rpx;
  top: 118rpx;
}

.hero-zigzag {
  right: 34rpx;
  top: 184rpx;
  transform: rotate(-12deg);
}

.hero-content {
  padding-right: 138rpx;
}
