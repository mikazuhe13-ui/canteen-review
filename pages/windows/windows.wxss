/* 渐变头部 */
.hero-header {
  position: relative;
  margin: -24rpx -24rpx 32rpx;
  padding: 56rpx 32rpx 48rpx;
  overflow: hidden;
  min-height: 280rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1A0F5E 0%, #2D1B8E 40%, #6C5CE7 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

.hero-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 楼层切换 */
.floor-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow-x: auto;
  white-space: nowrap;
}

.floor-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  background: transparent;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.floor-tab-icon {
  font-size: 24rpx;
}

.floor-tab.active {
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  color: #fff;
  font-weight: 600;
}

/* 窗口列表 */
.window-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.window-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.window-card:active {
  transform: scale(0.98) translateY(2rpx);
}

.window-img-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.window-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
}

.window-img-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,0.1));
  border-radius: 24rpx;
}

.window-info {
  flex: 1;
  margin-left: 24rpx;
}

.window-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.window-location-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.location-icon {
  font-size: 20rpx;
}

.window-location {
  font-size: 24rpx;
  color: #999;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.taste-tag {
  font-size: 20rpx;
  color: #6C5CE7;
  background: linear-gradient(135deg, #F0EDFF, #EDE8FF);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.window-rating {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  gap: 10rpx;
}

.rating-badge {
  display: flex;
  align-items: baseline;
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.rating-score {
  font-size: 36rpx;
  font-weight: 800;
  color: #6C5CE7;
}

.rating-star {
  font-size: 22rpx;
  color: #FFB800;
  margin-left: 2rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #999;
}

.dim-bars {
  margin-top: 12rpx;
}

.dim-bar {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.bar-label {
  font-size: 22rpx;
  color: #666;
  width: 60rpx;
}

.bar-track {
  flex: 1;
  height: 10rpx;
  background: #f0f0f0;
  border-radius: 5rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #A78BFA);
  border-radius: 5rpx;
  transition: width 0.5s;
}

.window-arrow {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow-circle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8f8f8, #f0f0f0);
  border-radius: 50%;
  transition: all 0.2s;
}

.window-card:active .arrow-circle {
  background: #f0f0f0;
}

.arrow-icon {
  font-size: 28rpx;
  color: #999;
  transition: color 0.2s;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-emoji {
  font-size: 56rpx;
}

.empty-text-main {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.empty-text-sub {
  display: block;
  font-size: 28rpx;
  color: #999;
}
