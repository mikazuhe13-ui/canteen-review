/* 渐变头部 */
.hero-header {
  position: relative;
  margin: -24rpx -24rpx 32rpx;
  padding: 56rpx 32rpx 48rpx;
  overflow: hidden;
  min-height: 280rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1A0F5E 0%, #2D1B8E 40%, #6C5CE7 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero-content {
  top: 70rpx;
  right: 15%;
  font-size: 36rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

.hero-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #6C5CE7, #A78BFA);
}

.stat-icon-circle {
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 12rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-circle-1 {
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
}

.stat-circle-2 {
  background: linear-gradient(135deg, #FFFDE7, #FFF9C4);
}

.stat-circle-3 {
  background: linear-gradient(135deg, #FCE4EC, #F8BBD0);
}

.stat-emoji {
  font-size: 32rpx;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #6C5CE7;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-icon-bg {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.icon-bg-trend {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.icon-bg-dim {
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
}

.icon-bg-tag {
  background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
}

.icon-bg-rank {
  background: linear-gradient(135deg, #FFFDE7, #FFF9C4);
}

.icon-bg-review {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
}

.card-icon-emoji {
  font-size: 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 多维平均分 */
.dim-avg-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dim-avg-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dim-avg-name {
  width: 100rpx;
  font-size: 26rpx;
  color: #666;
}

.dim-avg-bar {
  flex: 1;
  height: 18rpx;
  background: #f0f0f0;
  border-radius: 9rpx;
  overflow: hidden;
}

.dim-avg-fill {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #A78BFA);
  border-radius: 9rpx;
  transition: width 0.5s;
}

.dim-avg-score {
  width: 60rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: #6C5CE7;
}

/* 标签云 */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #F0EDFF, #EDE8FF);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.tag-item:active {
  transform: scale(0.95);
}

.tag-text {
  font-size: 24rpx;
  color: #6C5CE7;
  font-weight: 500;
}

.tag-count {
  font-size: 20rpx;
  color: #5B7FFF;
}

/* 窗口排行 */
.window-rank-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.window-rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.window-rank-item:last-child {
  border-bottom: none;
}

.rank-idx {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #999;
  flex-shrink: 0;
}

.rank-idx.top {
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  color: #fff;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.rank-score-badge {
  display: flex;
  align-items: baseline;
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.rank-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #6C5CE7;
}

.rank-score-star {
  font-size: 20rpx;
  color: #FFB800;
  margin-left: 2rpx;
}

.rank-count {
  font-size: 22rpx;
  color: #999;
}

/* 评价列表 */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review-card {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.review-card:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-window {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.review-stars .star {
  font-size: 24rpx;
  color: #ddd;
}

.review-stars .star.active {
  color: #FFB800;
}

.review-text {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.rewritten-section {
  background: linear-gradient(135deg, #F8F6FF, #F0EDFF);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-left: 6rpx solid #6C5CE7;
}

.rewritten-label {
  font-size: 22rpx;
  color: #6C5CE7;
  font-weight: 600;
  margin-right: 8rpx;
}

.rewritten-content {
  font-size: 24rpx;
  color: #666;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.mini-tag {
  font-size: 20rpx;
  color: #6C5CE7;
  background: #F0EDFF;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.review-time {
  font-size: 22rpx;
  color: #bbb;
  background: #f8f8f8;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

/* 7日趋势图 */
.trend-chart {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 260rpx;
  padding-top: 20rpx;
}

.trend-bar-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar {
  width: 100%;
  background: linear-gradient(180deg, #6C5CE7, #A78BFA);
  border-radius: 10rpx 10rpx 0 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 10rpx;
  transition: height 0.5s;
  position: relative;
}

.trend-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.2), transparent);
  border-radius: 10rpx 10rpx 0 0;
}

.trend-count {
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  margin-top: 6rpx;
  position: relative;
  z-index: 1;
}

.trend-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 审核过滤 */
.mod-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mod-tab {
  font-size: 26rpx;
  color: #999;
  padding: 10rpx 28rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}

.mod-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
}

/* 审核操作 */
.review-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.review-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.approve {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #4CAF50;
  font-weight: 600;
}

.action-btn.reject {
  background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
  color: #E53935;
  font-weight: 600;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-badge.approved {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #4CAF50;
}

.status-badge.rejected {
  background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
  color: #E53935;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-emoji {
  font-size: 56rpx;
}

.empty-text-main {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
