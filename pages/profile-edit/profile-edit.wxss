.page-wrap {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(22, 119, 255, 0.06) 0 4rpx, transparent 5rpx) 0 260rpx / 34rpx 34rpx,
    linear-gradient(180deg, #FFF8E8 0%, #F7F8FA 420rpx),
    #F7F8FA;
  padding: 116rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.edit-hero {
  position: relative;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 176, 32, 0.28) 0 42rpx, transparent 44rpx),
    linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);
  border: 4rpx solid #172033;
  border-radius: 28rpx;
  box-shadow: 10rpx 10rpx 0 #DCE7F5;
  overflow: hidden;
}

.hero-dot {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.dot-a {
  width: 18rpx;
  height: 18rpx;
  left: 34rpx;
  top: 26rpx;
  background: #FFB020;
  box-shadow: 28rpx 12rpx 0 rgba(22, 119, 255, 0.25), 14rpx 38rpx 0 rgba(255, 176, 32, 0.38);
}

.dot-b {
  width: 12rpx;
  height: 12rpx;
  right: 46rpx;
  bottom: 36rpx;
  background: rgba(34, 160, 107, 0.32);
  box-shadow: 24rpx -16rpx 0 rgba(34, 160, 107, 0.20);
}

.hero-kicker {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 23rpx;
  color: #8B5E00;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 44rpx;
  line-height: 1.15;
  color: #172033;
  font-weight: 900;
  text-shadow: 3rpx 3rpx 0 #FFE4A8;
}

.hero-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #697386;
}

.section {
  background: #fff;
  border: 3rpx solid #172033;
  border-radius: 22rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 7rpx 7rpx 0 #E5ECF5;
}

.avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
}

.avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.fallback-row {
  padding: 0 32rpx 28rpx;
  text-align: right;
}

.fallback-text {
  font-size: 24rpx;
  color: #1677FF;
  font-weight: 800;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FFE4A8;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.input-item-col {
  flex-direction: column;
  align-items: flex-start;
}

.input-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #172033;
  font-weight: 900;
  width: 120rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.bio-input {
  min-height: 120rpx;
  text-align: left;
  padding: 16rpx 20rpx;
  background: #F8FAFD;
  border: 2rpx solid #D8DFEA;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.btn-wrap {
  margin-top: 60rpx;
  padding: 0 40rpx;
}

.btn-save {
  background: #172033;
  color: #fff;
  border: 3rpx solid #172033;
  border-radius: 20rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 8rpx 8rpx 0 #FFB020;
}

.btn-save:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* Pop art layer */
.edit-hero {
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 79, 184, 0.20) 0 42rpx, transparent 44rpx),
    radial-gradient(circle at 18rpx 18rpx, rgba(0, 194, 255, 0.10) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);
}

.hero-title,
.label {
  text-shadow: 3rpx 3rpx 0 #FFE14D, 6rpx 6rpx 0 rgba(255, 79, 184, 0.18);
}

.section {
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(255, 79, 184, 0.07) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    #FFFFFF;
}

.avatar,
.btn-save,
.fallback-text {
  box-shadow: 4rpx 4rpx 0 #00C2FF;
}

.hero-burst {
  right: 22rpx;
  bottom: 24rpx;
}

.hero-chip {
  right: 108rpx;
  top: 26rpx;
}

.hero-zigzag {
  right: 30rpx;
  top: 92rpx;
  transform: rotate(-12deg);
}

.edit-hero {
  padding-right: 140rpx;
}
