.page-wrap {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
}

.avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.avatar-btn::after {
  display: none;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid #eee;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.input-item-col {
  flex-direction: column;
  align-items: flex-start;
}

.input-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  width: 120rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.bio-input {
  min-height: 120rpx;
  text-align: left;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.btn-wrap {
  margin-top: 60rpx;
  padding: 0 40rpx;
}

.btn-save {
  background: linear-gradient(135deg, #5B7FFF, #7B9AFF);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(91, 127, 255, 0.2);
}

.btn-save:active {
  opacity: 0.85;
  transform: scale(0.98);
}
