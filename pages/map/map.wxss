/* 装饰性渐变头部 */
.hero-header {
  position: relative;
  margin: -24rpx -24rpx 32rpx;
  padding: 56rpx 32rpx 48rpx;
  overflow: hidden;
  min-height: 280rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1565C0 0%, #42A5F5 40%, #64B5F6 100%);
  border-radius: 0 0 56rpx 56rpx;
}

.hero-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 260rpx;
  height: 260rpx;
  top: -60rpx;
  right: -40rpx;
}

.deco-2 {
  width: 180rpx;
  height: 180rpx;
  bottom: -30rpx;
  left: -30rpx;
}

.deco-star {
  position: absolute;
  font-size: 48rpx;
  opacity: 0.25;
}

.deco-3 {
  top: 40rpx;
  left: 20%;
}

.deco-4 {
  top: 70rpx;
  right: 15%;
  font-size: 36rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

.hero-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 食堂切换 */
.canteen-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.canteen-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 28rpx;
  background: transparent;
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-emoji {
  font-size: 24rpx;
}

.canteen-tab.active {
  background: linear-gradient(135deg, #1565C0, #42A5F5);
  color: #fff;
  font-weight: 600;
}

/* 楼层地图 */
.floor-map {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.floor-map-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.floor-map-icon-bg {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.floor-map-icon {
  font-size: 28rpx;
}

.floor-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.floor-selector {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.floor-btn {
  padding: 12rpx 36rpx;
  border-radius: 28rpx;
  background: #f0f0f0;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.floor-btn.active {
  background: linear-gradient(135deg, #1565C0, #42A5F5);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(21, 101, 192, 0.3);
}

.floor-btn:active {
  transform: scale(0.95);
}

/* 平面图 */
.floor-plan {
  position: relative;
  height: 620rpx;
  background: linear-gradient(180deg, #F0F4F8, #E3E8ED);
  border: 2rpx solid #DEE2E6;
  border-radius: 20rpx;
  overflow: hidden;
}

.floor-plan::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 30% 40%, rgba(21, 101, 192, 0.03) 0%, transparent 50%),
              radial-gradient(circle at 70% 60%, rgba(66, 165, 245, 0.03) 0%, transparent 50%);
}

.entrance {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #1565C0, #42A5F5);
  color: #fff;
  padding: 12rpx 48rpx;
  border-radius: 16rpx 16rpx 0 0;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 -4rpx 16rpx rgba(21, 101, 192, 0.25);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.entrance-icon {
  font-size: 22rpx;
}

.corridor {
  position: absolute;
  bottom: 56rpx;
  left: 8%;
  right: 8%;
  height: 44rpx;
  background: linear-gradient(90deg, #E0E0E0, #BDBDBD, #E0E0E0);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #757575;
  gap: 8rpx;
}

.corridor-icon {
  font-size: 18rpx;
}

.window-block {
  position: absolute;
  width: 42%;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  border-left: 8rpx solid transparent;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.window-block:active {
  transform: scale(0.96);
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.12);
}

.window-block.hot {
  border-left-color: #6C5CE7;
  background: linear-gradient(135deg, #F5F3FF, #F0EDFF);
}

.window-block.normal {
  border-left-color: #FFB800;
  background: linear-gradient(135deg, #FFFDE7, #FFF8E1);
}

.window-block.cold {
  border-left-color: #9E9E9E;
  background: linear-gradient(135deg, #F5F5F5, #EEEEEE);
}

.block-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.block-score-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.block-score {
  font-size: 36rpx;
  font-weight: 700;
  color: #6C5CE7;
}

.block-score-star {
  font-size: 22rpx;
  color: #FFB800;
  margin-left: 4rpx;
}

.block-count {
  font-size: 22rpx;
  color: #999;
}

.block-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.mini-tag {
  font-size: 20rpx;
  color: #6C5CE7;
  background: #F0EDFF;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

/* 图例 */
.legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 8rpx;
}

.legend-dot.hot {
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  box-shadow: 0 4rpx 8rpx rgba(108, 92, 231, 0.3);
}

.legend-dot.normal {
  background: linear-gradient(135deg, #FFB800, #FFC107);
  box-shadow: 0 4rpx 8rpx rgba(255, 184, 0, 0.3);
}

.legend-dot.cold {
  background: linear-gradient(135deg, #9E9E9E, #BDBDBD);
}

.legend-item text {
  font-size: 24rpx;
  color: #666;
}
