/* 装饰性渐变头部 */
.hero-header {
  position: relative;
  margin: -24rpx -24rpx 32rpx;
  padding: 56rpx 32rpx 48rpx;
  overflow: hidden;
  min-height: 320rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1A0F5E 0%, #2D1B8E 40%, #6C5CE7 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
  letter-spacing: 4rpx;
}

.hero-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* Tab */
.tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 28rpx;
  background: transparent;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon {
  font-size: 24rpx;
}

.tab.active {
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  color: #fff;
  font-weight: 600;
}

/* 领奖台 */
.podium-section {
  margin-bottom: 32rpx;
}

.podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 12rpx;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.podium-item {
  flex: 1;
  text-align: center;
  position: relative;
  transition: all 0.3s;
}

.podium-item:active {
  transform: scale(0.96);
}

.podium-crown {
  font-size: 40rpx;
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.podium-medal {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.podium-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin: 0 auto 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.podium-1 .podium-avatar {
  width: 104rpx;
  height: 104rpx;
}

.podium-avatar.rank-1 {
  background: linear-gradient(135deg, #FFD54F, #FFC107);
}

.podium-avatar.rank-2 {
  background: linear-gradient(135deg, #E0E0E0, #BDBDBD);
}

.podium-avatar.rank-3 {
  background: linear-gradient(135deg, #90A4AE, #78909C);
}

.podium-initial {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

.podium-1 .podium-initial {
  font-size: 44rpx;
}

.podium-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
}

.podium-1 .podium-name {
  font-size: 28rpx;
  font-weight: 700;
}

.podium-score {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 12rpx;
}

.podium-score-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #6C5CE7;
}

.podium-1 .podium-score-num {
  font-size: 40rpx;
}

.podium-score-label {
  font-size: 20rpx;
  color: #6C5CE7;
  margin-left: 2rpx;
}

.podium-bar {
  height: 120rpx;
  border-radius: 16rpx 16rpx 0 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 12rpx;
}

.bar-rank {
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.6);
}

.podium-1 .podium-bar {
  height: 160rpx;
}

.podium-3 .podium-bar {
  height: 100rpx;
}

.bar-1 {
  background: linear-gradient(180deg, #FFD54F, #FFC107);
}

.bar-2 {
  background: linear-gradient(180deg, #E0E0E0, #BDBDBD);
}

.bar-3 {
  background: linear-gradient(180deg, #90A4AE, #78909C);
}

/* AI推荐卡 */
.ai-recommend-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 20rpx;
  padding: 28rpx;
  color: #fff;
}

.ai-recommend-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.ai-recommend-icon {
  font-size: 32rpx;
}

.ai-recommend-title {
  font-size: 28rpx;
  font-weight: 600;
}

.ai-recommend-text {
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.95;
}

/* 排行列表 */
.rank-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.rank-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.rank-list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.rank-list-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #f8f8f8;
  transition: all 0.2s;
}

.rank-item:active {
  background: #f8f8f8;
  transform: scale(0.99);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-num-1 {
  background: linear-gradient(135deg, #FFD54F, #FFC107);
  color: #fff;
}

.rank-num-2 {
  background: linear-gradient(135deg, #E0E0E0, #BDBDBD);
  color: #fff;
}

.rank-num-3 {
  background: linear-gradient(135deg, #90A4AE, #78909C);
  color: #fff;
}

.rank-num-normal {
  background: #f5f5f5;
  color: #999;
}

.rank-info {
  flex: 1;
}

.rank-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.rank-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.meta-icon {
  font-size: 20rpx;
}

.meta-score {
  font-size: 24rpx;
  color: #6C5CE7;
  font-weight: 600;
}

.meta-count {
  font-size: 24rpx;
  color: #999;
}

.meta-hot {
  font-size: 24rpx;
  color: #E53935;
}

.rank-likes {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF5F5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.likes-icon {
  font-size: 22rpx;
}

.likes-count {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: 600;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #F0EDFF, #E0DBFF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}
