<view class="page">
  <view class="report-hero">
    <view class="comic-dot dot-a"></view>
    <view class="comic-dot dot-b"></view>
    <view class="pop-burst hero-burst"><text>TOP!</text></view>
    <view class="campus-chip hero-chip">FOOD BATTLE</view>
    <view class="pop-zigzag hero-zigzag"></view>
    <view class="report-title-row">
      <view class="report-main">
        <text class="report-kicker">校园美食数据</text>
        <text class="report-title">{{period === 'daily' ? '今日' : '本周'}}食堂战报</text>
        <text class="report-meta">{{rankings.length}} 个窗口上榜 · {{overview.reviewText}} · {{updateTime}} 更新</text>
      </view>
      <view class="report-badge">
        <text class="badge-num">{{overview.scoreText}}</text>
        <text class="badge-label">热度</text>
      </view>
    </view>

    <view class="period-row">
      <view class="period-btn {{period === 'daily' ? 'active' : ''}}" bindtap="switchPeriod" data-period="daily">
        <text class="period-icon">📅</text>
        <text>今日榜</text>
      </view>
      <view class="period-btn {{period === 'weekly' ? 'active' : ''}}" bindtap="switchPeriod" data-period="weekly">
        <text class="period-icon">📆</text>
        <text>本周榜</text>
      </view>
    </view>

    <view class="overview-row">
      <view class="overview-item">
        <text class="overview-num">{{overview.windowCount}}</text>
        <text class="overview-label">窗口</text>
      </view>
      <view class="overview-item">
        <text class="overview-num">{{overview.reviewCount}}</text>
        <text class="overview-label">评价</text>
      </view>
      <view class="overview-item">
        <text class="overview-num">{{overview.avgScore}}</text>
        <text class="overview-label">均分</text>
      </view>
    </view>
  </view>

  <scroll-view class="tab-scroll" scroll-x enable-flex>
    <view class="tab-row">
      <view
        class="tab-pill {{currentTab === item.key ? 'active' : ''}}"
        wx:for="{{period === 'daily' ? dailyTabs : weeklyTabs}}"
        wx:key="key"
        bindtap="switchTab"
        data-tab="{{item.key}}"
      >
        <text class="tab-pill-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- AI 榜单观察 -->
  <view class="ai-observe" wx:if="{{aiObserve}}">
    <view class="ai-observe-head">
      <text class="ai-observe-icon">🤖</text>
      <text class="ai-observe-label">{{period === 'daily' ? '今日' : '本周'}}AI观察</text>
    </view>
    <text class="ai-observe-text">{{aiObserve}}</text>
  </view>

  <view class="champion-card" wx:if="{{champion}}" bindtap="goToDetail" data-id="{{champion.windowId}}">
    <view class="champion-left">
      <view class="champion-avatar">
        <text class="champion-initial">{{champion.windowName[0]}}</text>
      </view>
    </view>
    <view class="champion-mid">
      <view class="champion-crown">👑</view>
      <text class="champion-name">{{champion.windowName}}</text>
      <text class="champion-loc">{{champion.location || '校园美食区'}}</text>
      <view class="champion-tags">
        <text class="ctag ctag-score">{{champion.avgScore}} 分</text>
        <text class="ctag ctag-count">{{champion.reviewCount}} 条评价</text>
        <text class="ctag ctag-rise" wx:if="{{champion.rise > 0}}">↑{{champion.rise}}</text>
      </view>
    </view>
    <view class="champion-right">
      <text class="champion-score-num">{{champion.avgScore}}</text>
      <text class="champion-go">去看看 ›</text>
    </view>
  </view>

  <view class="podium-wrap" wx:if="{{top3.length > 1}}">
    <view class="podium">
      <view class="podium-card pod-silver" wx:if="{{top3[1]}}" bindtap="goToDetail" data-id="{{top3[1].windowId}}">
        <view class="pod-tag silver">🥈 2nd</view>
        <view class="pod-avatar silver-bg"><text class="pod-letter">{{top3[1].windowName[0]}}</text></view>
        <text class="pod-name">{{top3[1].windowName}}</text>
        <text class="pod-score">{{top3[1].avgScore}}分</text>
      </view>
      <view class="podium-card pod-gold" wx:if="{{top3[0]}}" bindtap="goToDetail" data-id="{{top3[0].windowId}}">
        <view class="pod-tag gold">🥇 1st</view>
        <view class="pod-avatar gold-bg"><text class="pod-letter">{{top3[0].windowName[0]}}</text></view>
        <text class="pod-name">{{top3[0].windowName}}</text>
        <text class="pod-score">{{top3[0].avgScore}}分</text>
      </view>
      <view class="podium-card pod-bronze" wx:if="{{top3[2]}}" bindtap="goToDetail" data-id="{{top3[2].windowId}}">
        <view class="pod-tag bronze">🥉 3rd</view>
        <view class="pod-avatar bronze-bg"><text class="pod-letter">{{top3[2].windowName[0]}}</text></view>
        <text class="pod-name">{{top3[2].windowName}}</text>
        <text class="pod-score">{{top3[2].avgScore}}分</text>
      </view>
    </view>
  </view>

  <scroll-view class="quick-scroll" scroll-x enable-flex>
    <view class="quick-cats">
      <view
        class="quick-cat {{currentTab === item.key ? 'qc-active' : ''}}"
        wx:for="{{quickCats}}"
        wx:key="key"
        bindtap="switchQuick"
        data-key="{{item.key}}"
      >
        <text class="qc-emoji">{{item.emoji}}</text>
        <text class="qc-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="rank-section">
    <view class="rank-head">
      <text class="rank-title">完整排行</text>
      <text class="rank-count">共 {{rankings.length}} 家</text>
    </view>
    <view class="rank-list" wx:if="{{rankings.length > 0}}">
      <view
        class="rank-item"
        wx:for="{{rankings}}"
        wx:key="windowId"
        bindtap="goToDetail"
        data-id="{{item.windowId}}"
      >
        <view class="rank-num r{{index < 3 ? index + 1 : 'n'}}">
          <text>{{index + 1}}</text>
        </view>
        <view class="rank-info">
          <text class="rank-name">{{item.windowName}}</text>
          <view class="rank-meta">
            <text class="rm-score">{{item.avgScore}} 分</text>
            <text class="rm-dot">·</text>
            <text class="rm-count">{{item.reviewCount}} 评价</text>
            <text class="rm-dot" wx:if="{{item.location}}">·</text>
            <text class="rm-loc" wx:if="{{item.location}}">{{item.location}}</text>
          </view>
        </view>
        <view class="rank-side">
          <text class="rank-rise" wx:if="{{item.rise > 0}}">↑{{item.rise}}</text>
          <text class="rank-bad" wx:if="{{item.badRatio > 0.3}}">⚠️</text>
          <text class="rank-go">去看看</text>
        </view>
      </view>
    </view>
  </view>

  <view class="match-section" wx:if="{{tasteMatch.length > 0}}">
    <view class="match-head">
      <text class="match-title">我的口味匹配</text>
      <text class="match-badge">AI推荐</text>
    </view>
    <text class="match-desc">根据你的浏览和评价，推荐你可能喜欢的窗口</text>
    <view class="match-list">
      <view
        class="match-card"
        wx:for="{{tasteMatch}}"
        wx:key="windowId"
        bindtap="goToDetail"
        data-id="{{item.windowId}}"
      >
        <view class="match-avatar"><text class="match-letter">{{item.windowName[0]}}</text></view>
        <view class="match-info">
          <text class="match-name">{{item.windowName}}</text>
          <text class="match-reason">{{item.matchReason}}</text>
        </view>
        <text class="match-score">{{item.avgScore}}</text>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{rankings.length === 0 && !loading}}">
    <view class="empty-icon">🏆</view>
    <text class="empty-title">暂无排名数据</text>
    <text class="empty-desc">需要同学评价后，榜单才会自动生成</text>
    <view class="empty-action" bindtap="goFeedback">去评价一下</view>
    <view class="empty-grid">
      <view class="empty-card">
        <text class="empty-card-icon">🔥</text>
        <text class="empty-card-title">人气榜</text>
        <text class="empty-card-desc">按评价、点赞和热度计算</text>
      </view>
      <view class="empty-card">
        <text class="empty-card-icon">🤖</text>
        <text class="empty-card-title">AI观察</text>
        <text class="empty-card-desc">自动总结每日和每周趋势</text>
      </view>
    </view>
  </view>

</view>
