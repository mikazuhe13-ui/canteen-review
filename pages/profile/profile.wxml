<view class="page-wrap">
  <!-- 背景图 -->
  <view class="bg-wrap">
    <image class="bg-image" src="/images/profile-bg.jpg" mode="aspectFill" />
    <view class="bg-overlay"></view>
  </view>

  <!-- 顶部个人信息卡片 -->
  <view class="profile-card" bindtap="goEditProfile">
    <view class="profile-row">
      <view class="avatar-wrapper">
        <image class="avatar" src="{{user.avatar || '/images/avatar.png'}}" mode="aspectFill" />
      </view>
      <view class="profile-info">
        <text class="nickname">{{user.nickname}}</text>
        <text class="bio">{{user.bio || '这个人很懒，什么都没留下~'}}</text>
      </view>
      <text class="edit-arrow">›</text>
    </view>
    <view class="credit-row">
      <text class="credit-label">信用分</text>
      <text class="credit-num">{{user.creditScore}}</text>
    </view>
  </view>

  <!-- 校园资产 -->
  <view class="asset-row">
    <view class="asset-item">
      <text class="asset-num">{{user.reviewCount}}</text>
      <text class="asset-label">发布</text>
    </view>
    <view class="asset-divider"></view>
    <view class="asset-item">
      <text class="asset-num">{{totalLikes}}</text>
      <text class="asset-label">获赞</text>
    </view>
    <view class="asset-divider"></view>
    <view class="asset-item">
      <text class="asset-num">0</text>
      <text class="asset-label">反馈</text>
    </view>
    <view class="asset-divider"></view>
    <view class="asset-item">
      <text class="asset-num">0</text>
      <text class="asset-label">积分</text>
    </view>
  </view>

  <!-- AI 助手 -->
  <view class="ai-card" bindtap="goAI">
    <view class="ai-left">
      <view class="ai-icon">
        <image class="ai-icon-img" src="/images/icons/profile/ai.svg" mode="aspectFit" />
      </view>
      <view class="ai-info">
        <text class="ai-title">校园 AI 助手</text>
        <text class="ai-desc">问办事流程、找失物线索、推荐今天吃什么</text>
      </view>
    </view>
    <text class="ai-btn">立即咨询</text>
  </view>

  <!-- 我的内容 -->
  <view class="section">
    <text class="section-title">我的内容</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="goFeed">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/posts.svg" mode="aspectFit" /></view>
        <text class="menu-text">我的发布</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyReviews">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/reviews.svg" mode="aspectFit" /></view>
        <text class="menu-text">我的评价</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goFavorites">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/favorite.svg" mode="aspectFit" /></view>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goHistory">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/history.svg" mode="aspectFit" /></view>
        <text class="menu-text">浏览记录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 校园服务 -->
  <view class="section">
    <text class="section-title">校园服务</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="goFeedback">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/feedback.svg" mode="aspectFit" /></view>
        <text class="menu-text">我的反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goLostFound">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/lost.svg" mode="aspectFit" /></view>
        <text class="menu-text">失物记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goCoupons">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/coupon.svg" mode="aspectFit" /></view>
        <text class="menu-text">优惠卡券</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onShare">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/invite.svg" mode="aspectFit" /></view>
        <text class="menu-text">邀请好友</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 更多 -->
  <view class="section">
    <text class="section-title">更多</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="goSettings">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/settings.svg" mode="aspectFit" /></view>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/about.svg" mode="aspectFit" /></view>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" wx:if="{{user.isAdmin}}" bindtap="goAdmin">
        <view class="menu-icon-wrap"><image class="menu-icon-img" src="/images/icons/profile/admin.svg" mode="aspectFit" /></view>
        <text class="menu-text">管理后台</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-wrap" bindtap="logout">
    <text class="logout-text">退出登录</text>
  </view>
</view>
