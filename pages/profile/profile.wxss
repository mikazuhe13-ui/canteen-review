.page-wrap {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(22, 119, 255, 0.07) 0 4rpx, transparent 5rpx) 0 180rpx / 34rpx 34rpx,
    linear-gradient(180deg, #FFF8E8 0%, #F7F8FA 470rpx),
    #F7F8FA;
  padding: 0 24rpx 178rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.top-field {
  position: relative;
  margin: 0 -24rpx;
  padding: 126rpx 28rpx 70rpx;
  background: #172033;
  border-bottom: 5rpx solid #172033;
  overflow: hidden;
}

.top-bg-image {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.top-bg-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 82% 20%, rgba(255, 176, 32, 0.30) 0 42rpx, transparent 44rpx),
    linear-gradient(180deg, rgba(23, 32, 51, 0.18) 0%, rgba(23, 32, 51, 0.48) 100%);
}

.top-field::after {
  content: '';
  position: absolute;
  left: -80rpx;
  bottom: -92rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(22, 119, 255, 0.20);
}

.comic-dot {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.dot-a {
  width: 18rpx;
  height: 18rpx;
  right: 58rpx;
  top: 82rpx;
  background: #FFB020;
  box-shadow: 26rpx 14rpx 0 rgba(255, 255, 255, 0.28), -22rpx 34rpx 0 rgba(34, 160, 107, 0.40);
}

.dot-b {
  width: 12rpx;
  height: 12rpx;
  left: 52rpx;
  bottom: 54rpx;
  background: rgba(255, 255, 255, 0.40);
  box-shadow: 28rpx -16rpx 0 rgba(255, 176, 32, 0.55), 52rpx 8rpx 0 rgba(255, 255, 255, 0.20);
}

.page-title-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.page-kicker {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.page-title {
  display: block;
  font-size: 56rpx;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 900;
  text-shadow: 4rpx 4rpx 0 rgba(255, 176, 32, 0.52);
}

.credit-badge {
  min-width: 120rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #FFF7E8;
  border: 3rpx solid #172033;
  box-shadow: 6rpx 6rpx 0 #FFB020;
  text-align: center;
  margin-right: 12rpx;
}

.credit-label {
  display: block;
  font-size: 19rpx;
  color: #6B4E16;
  font-weight: 700;
}

.credit-num {
  display: block;
  margin-top: 2rpx;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
  color: #172033;
}

.profile-card {
  position: relative;
  z-index: 2;
  margin-top: -52rpx;
  padding: 28rpx 22rpx 20rpx;
  background: #FFFFFF;
  border: 4rpx solid #172033;
  border-radius: 30rpx;
  box-shadow: 10rpx 10rpx 0 #FF4FB8;
  overflow: visible;
}

.profile-card::after {
  content: '';
  position: absolute;
  right: -46rpx;
  bottom: -48rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255, 176, 32, 0.12);
}

.profile-pop {
  position: absolute;
  left: 22rpx;
  top: -18rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #FFE14D;
  color: #172033;
  border: 2rpx solid #172033;
  box-shadow: 4rpx 4rpx 0 #00C2FF;
  display: flex;
  align-items: center;
  font-size: 15rpx;
  font-weight: 900;
  transform: rotate(-5deg);
}

.profile-burst {
  position: absolute;
  right: 22rpx;
  top: -28rpx;
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx 50% 24rpx 50%;
  background: #FF4FB8;
  color: #FFFFFF;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FFE14D;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(12deg);
}

.profile-burst text {
  font-size: 20rpx;
  font-weight: 900;
}

.profile-speed {
  position: absolute;
  right: 88rpx;
  top: 40rpx;
  width: 120rpx;
  height: 54rpx;
  background:
    linear-gradient(90deg, #172033 0 42rpx, transparent 42rpx) 0 0 / 120rpx 6rpx,
    linear-gradient(90deg, #172033 0 82rpx, transparent 82rpx) 0 20rpx / 120rpx 6rpx,
    linear-gradient(90deg, #172033 0 54rpx, transparent 54rpx) 0 40rpx / 120rpx 6rpx;
  opacity: 0.10;
  transform: rotate(-8deg);
}

.profile-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 34rpx;
  display: block;
  border: 4rpx solid #172033;
  background: #F1F4F8;
}

.avatar-wrapper::before {
  content: '';
  position: absolute;
  left: -14rpx;
  top: -14rpx;
  width: 148rpx;
  height: 148rpx;
  border-radius: 42rpx 50% 42rpx 50%;
  background: #FFE14D;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #00C2FF;
  transform: rotate(-8deg);
}

.avatar {
  position: relative;
  z-index: 1;
}

.avatar-sticker {
  position: absolute;
  z-index: 2;
  right: -12rpx;
  bottom: -8rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #FF4D4F;
  border: 2rpx solid #172033;
  color: #FFFFFF;
  font-size: 16rpx;
  line-height: 30rpx;
  font-weight: 900;
  transform: rotate(-6deg);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #172033;
  margin-bottom: 8rpx;
  text-shadow: 3rpx 3rpx 0 #FFE14D;
}

.bio {
  display: block;
  font-size: 23rpx;
  color: #697386;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-arrow {
  font-size: 44rpx;
  color: #172033;
  flex-shrink: 0;
  line-height: 1;
}

.identity-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #D8DFEA;
}

.identity-pill {
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: #00C2FF;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  font-size: 18rpx;
  font-weight: 900;
  box-shadow: 3rpx 3rpx 0 #FFE14D;
}

.identity-green {
  background: #FF4FB8;
  color: #FFFFFF;
}

.identity-copy {
  min-width: 0;
  flex: 1;
  font-size: 21rpx;
  color: #8A93A3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 22rpx;
  padding: 24rpx 0 18rpx;
  margin: 20rpx 0;
  box-shadow: 7rpx 7rpx 0 #FFE14D;
  overflow: visible;
}

.asset-pop {
  position: absolute;
  left: 18rpx;
  top: -16rpx;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #FF4FB8;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  box-shadow: 3rpx 3rpx 0 #00C2FF;
  display: flex;
  align-items: center;
  font-size: 14rpx;
  font-weight: 900;
  transform: rotate(-4deg);
}

.asset-item {
  flex: 1;
  text-align: center;
}

.asset-num {
  display: block;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 900;
  color: #172033;
  text-shadow: 3rpx 3rpx 0 #00C2FF;
}

.asset-label {
  display: block;
  font-size: 21rpx;
  color: #8A93A3;
  margin-top: 8rpx;
  font-weight: 700;
}

.asset-divider {
  width: 1rpx;
  height: 42rpx;
  background: #EEF2F7;
}

.ai-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 20rpx;
  background:
    radial-gradient(circle at 92% 18%, rgba(255, 176, 32, 0.30) 0 28rpx, transparent 30rpx),
    linear-gradient(135deg, #172033 0%, #253B5C 100%);
  border: 4rpx solid #172033;
  border-radius: 24rpx;
  box-shadow: 8rpx 8rpx 0 #FFB020;
  margin-bottom: 24rpx;
  overflow: visible;
}

.ai-pop {
  position: absolute;
  right: 72rpx;
  top: -16rpx;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #FFE14D;
  color: #172033;
  border: 2rpx solid #172033;
  box-shadow: 3rpx 3rpx 0 #FF4FB8;
  display: flex;
  align-items: center;
  font-size: 15rpx;
  font-weight: 900;
  transform: rotate(5deg);
}

.ai-mark {
  width: 70rpx;
  height: 70rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.ai-info {
  flex: 1;
  min-width: 0;
}

.ai-title {
  display: block;
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.ai-desc {
  display: block;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.68);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-btn {
  width: 58rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: #FFE14D;
  color: #172033;
  border: 3rpx solid #172033;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: 900;
  flex-shrink: 0;
  box-shadow: 4rpx 4rpx 0 #FF4FB8;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 14rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #172033;
  text-shadow: 3rpx 3rpx 0 #FFE4A8;
}

.section-more {
  font-size: 23rpx;
  color: #8A93A3;
  font-weight: 700;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.tool-card {
  position: relative;
  min-height: 142rpx;
  padding: 18rpx 6rpx 10rpx;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 20rpx;
  box-shadow: 5rpx 5rpx 0 #E5ECF5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.tool-burst {
  position: absolute;
  left: -18rpx;
  bottom: -18rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx 50% 20rpx 50%;
  background: #FFE14D;
  border: 2rpx solid #172033;
  transform: rotate(12deg);
}

.tool-card:active,
.menu-item:active,
.profile-card:active,
.ai-card:active {
  transform: scale(0.99);
}

.tool-sticker {
  position: absolute;
  top: 6rpx;
  right: 4rpx;
  height: 26rpx;
  padding: 0 7rpx;
  border-radius: 7rpx;
  background: #1677FF;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  font-size: 14rpx;
  line-height: 26rpx;
  font-weight: 900;
  transform: rotate(5deg);
}

.sticker-green {
  background: #22A06B;
}

.sticker-amber {
  background: #FFB020;
  color: #172033;
}

.sticker-red {
  background: #FF4D4F;
}

.tool-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  border: 3rpx solid #172033;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}

.tool-blue {
  background: #EAF3FF;
}

.tool-green {
  background: #EAF7F0;
}

.tool-amber {
  background: #FFF7E8;
}

.tool-red {
  background: #FFF0F0;
}

.tool-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.tool-title {
  display: block;
  max-width: 100%;
  font-size: 21rpx;
  line-height: 1.25;
  color: #172033;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  position: relative;
  z-index: 1;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 22rpx;
  box-shadow: 6rpx 6rpx 0 #E5ECF5;
  position: relative;
  overflow: hidden;
}

.menu-item::after {
  content: '';
  position: absolute;
  right: 74rpx;
  top: 24rpx;
  width: 82rpx;
  height: 38rpx;
  background:
    linear-gradient(90deg, #172033 0 32rpx, transparent 32rpx) 0 0 / 82rpx 6rpx,
    linear-gradient(90deg, #172033 0 58rpx, transparent 58rpx) 0 16rpx / 82rpx 6rpx,
    linear-gradient(90deg, #172033 0 36rpx, transparent 36rpx) 0 32rpx / 82rpx 6rpx;
  opacity: 0.07;
}

.menu-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  border: 2rpx solid #172033;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-blue {
  background: #EAF3FF;
}

.icon-green {
  background: #EAF7F0;
}

.icon-amber {
  background: #FFF7E8;
}

.icon-red {
  background: #FFF0F0;
}

.icon-dark {
  background: #EEF2F7;
}

.menu-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.25;
  color: #172033;
  font-weight: 900;
  text-shadow: 2rpx 2rpx 0 rgba(255, 225, 77, 0.65);
}

.menu-desc {
  display: block;
  margin-top: 5rpx;
  font-size: 21rpx;
  color: #8A93A3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: #172033;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  box-shadow: 3rpx 3rpx 0 #FF4FB8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  line-height: 1;
}

.logout-wrap {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 22rpx 0;
  text-align: center;
}

.logout-text {
  font-size: 24rpx;
  color: #8A93A3;
  font-weight: 700;
}

/* Pop art layer */
.top-bg-overlay {
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(255, 225, 77, 0.34) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    radial-gradient(circle at 82% 20%, rgba(255, 79, 184, 0.28) 0 42rpx, transparent 44rpx),
    linear-gradient(180deg, rgba(23, 32, 51, 0.10) 0%, rgba(23, 32, 51, 0.45) 100%);
}

.page-title,
.section-title {
  text-shadow: 3rpx 3rpx 0 #FFE14D, 6rpx 6rpx 0 rgba(255, 79, 184, 0.28);
}

.credit-badge,
.avatar,
.tool-icon,
.menu-icon-wrap {
  box-shadow: 4rpx 4rpx 0 #00C2FF;
}

.profile-card,
.asset-row,
.tool-card,
.menu-item {
  background:
    repeating-linear-gradient(-12deg, rgba(255, 225, 77, 0.08) 0 8rpx, transparent 8rpx 18rpx),
    radial-gradient(circle at 18rpx 18rpx, rgba(255, 79, 184, 0.07) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    #FFFFFF;
}

.hero-burst {
  right: 26rpx;
  bottom: 34rpx;
}

.hero-chip {
  right: 112rpx;
  top: 92rpx;
}

.hero-zigzag {
  right: 34rpx;
  top: 150rpx;
  transform: rotate(-12deg);
}

.page-title-row {
  padding-right: 128rpx;
}
