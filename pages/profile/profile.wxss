.page-wrap {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 180rpx;
  position: relative;
}

/* 背景图 */
.bg-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  overflow: hidden;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.3) 100%);
}

/* 个人信息卡片 */
.profile-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  margin-top: 280rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.profile-row {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.bio {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-arrow {
  font-size: 36rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.credit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.credit-label {
  font-size: 24rpx;
  color: #999;
}

.credit-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #6C5CE7;
}

/* 校园资产 */
.asset-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.asset-item {
  flex: 1;
  text-align: center;
}

.asset-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a1a;
}

.asset-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.asset-divider {
  width: 2rpx;
  height: 36rpx;
  background: #f0f0f0;
}

/* AI 助手 */
.ai-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1A1A2E, #16213E);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.ai-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.ai-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.ai-info {
  display: flex;
  flex-direction: column;
}

.ai-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
}

.ai-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.ai-btn {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  padding: 12rpx 24rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 20rpx;
}

/* 分组标题 */
.section {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

/* 菜单列表 */
.menu-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #fafafa;
}

.menu-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #F3F7FC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-wrap {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
}

.logout-text {
  font-size: 24rpx;
  color: #bbb;
}
