.container {
  min-height: 100vh;
  background: #f8f6f3;
  padding-bottom: 140rpx;
}

/* 渐变头部 */
.hero-header {
  position: relative;
  height: 340rpx;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #1A0F5E 0%, #2D1B8E 50%, #6C5CE7 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 60rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 16rpx;
}

.badge-icon { font-size: 24rpx; margin-right: 8rpx; }
.badge-text { font-size: 22rpx; color: #fff; }

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* 筛选栏 */
.filter-row {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 32rpx 12rpx;
}

.filter-tab {
  padding: 14rpx 32rpx;
  border-radius: 24rpx;
  background: #fff;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-tab.active {
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  color: #fff;
}

/* 动态列表 */
.feed-list {
  padding: 16rpx 28rpx;
}

.feed-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

/* 头部 */
.feed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.feed-user-row {
  display: flex;
  align-items: center;
}

.feed-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.feed-initial {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.feed-user-info {
  display: flex;
  flex-direction: column;
}

.feed-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.feed-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.feed-score-pill {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.feed-score-num {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

.feed-score-star {
  font-size: 20rpx;
  color: #FFD700;
  margin-left: 4rpx;
}

/* 窗口行 */
.feed-window-row {
  display: flex;
  align-items: center;
  background: #f8f6f3;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.feed-window-icon { font-size: 28rpx; margin-right: 12rpx; }
.feed-window-name { font-size: 26rpx; color: #555; flex: 1; }
.feed-window-arrow { font-size: 24rpx; color: #ccc; }

/* 评价内容 */
.feed-content {
  margin-bottom: 16rpx;
}

.feed-bubble {
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.user-bubble {
  background: #f5f5f5;
}

.ai-bubble {
  background: linear-gradient(135deg, #E8D5F5, #F0E6FA);
  border: 1rpx solid rgba(156,39,176,0.1);
}

.ai-badge {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.ai-badge-icon { font-size: 22rpx; margin-right: 6rpx; }
.ai-badge-text { font-size: 20rpx; color: #9C27B0; font-weight: 500; }

.feed-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.ai-text {
  color: #6A1B9A;
}

/* 标签 */
.feed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.feed-tag {
  font-size: 22rpx;
  color: #6C5CE7;
  background: rgba(108,92,231,0.08);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

/* 底部操作 */
.feed-footer {
  display: flex;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.feed-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.action-icon {
  font-size: 28rpx;
  color: #999;
}

.action-icon.liked {
  color: #FF4757;
}

.action-count, .action-text {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(108,92,231,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon-emoji { font-size: 64rpx; }
.empty-text-main { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.empty-text-sub { font-size: 24rpx; color: #999; }
