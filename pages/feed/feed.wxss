page {
  background: #F7F8FA;
}

.page {
  min-height: 100vh;
  padding: 0 24rpx 200rpx;
  padding-top: calc(env(safe-area-inset-top) + 92rpx);
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(22, 119, 255, 0.06) 0 4rpx, transparent 5rpx) 0 290rpx / 34rpx 34rpx,
    linear-gradient(180deg, #FFF8E8 0%, #F7F8FA 460rpx),
    #F7F8FA;
}

.feed-hero {
  position: relative;
  padding: 22rpx 24rpx 24rpx;
  margin-bottom: 18rpx;
  background:
    radial-gradient(circle at 94% 16%, rgba(255, 176, 32, 0.26) 0 40rpx, transparent 42rpx),
    linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);
  border: 4rpx solid #172033;
  border-radius: 28rpx;
  box-shadow: 10rpx 10rpx 0 #DCE7F5;
  overflow: hidden;
}

.comic-dot {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.dot-a {
  width: 16rpx;
  height: 16rpx;
  left: 30rpx;
  top: 24rpx;
  background: #FFB020;
  box-shadow: 28rpx 12rpx 0 rgba(22, 119, 255, 0.22), 14rpx 38rpx 0 rgba(255, 176, 32, 0.36);
}

.dot-b {
  width: 12rpx;
  height: 12rpx;
  right: 42rpx;
  bottom: 34rpx;
  background: rgba(34, 160, 107, 0.30);
  box-shadow: 22rpx -18rpx 0 rgba(34, 160, 107, 0.18);
}

.page-title {
  position: relative;
  z-index: 1;
  padding-right: 190rpx;
}

.page-kicker {
  display: block;
  font-size: 22rpx;
  color: #6B4E16;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.page-title-text {
  display: block;
  font-size: 44rpx;
  line-height: 1.12;
  font-weight: 900;
  color: #172033;
  text-shadow: 3rpx 3rpx 0 #FFE4A8;
}

.page-title-sub {
  display: block;
  font-size: 22rpx;
  color: #8A93A3;
  margin-top: 4rpx;
}

.bulletin-scroll {
  margin: 0 -24rpx;
  white-space: nowrap;
  margin-bottom: 14rpx;
}

.bulletin-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}

.bulletin-card {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 20rpx;
  background: #FFF7E8;
  border: 3rpx solid #FFCF7A;
  border-radius: 999rpx;
  flex-shrink: 0;
  box-shadow: 4rpx 4rpx 0 rgba(255, 207, 122, 0.30);
}

.bulletin-icon { font-size: 22rpx; }

.bulletin-text {
  font-size: 22rpx;
  color: #8B5E00;
  font-weight: 600;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.quick-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 0;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 18rpx;
  box-shadow: 5rpx 5rpx 0 #E5ECF5;
}

.quick-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border: 2rpx solid rgba(23, 32, 51, 0.10);
}

.qi-blue { background: #EAF3FF; }
.qi-amber { background: #FFF7E8; }
.qi-red { background: #FFF0F0; }
.qi-purple { background: #F0ECFF; }

.quick-label {
  font-size: 20rpx;
  color: #172033;
  font-weight: 800;
  white-space: nowrap;
}

.ai-daily {
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 22rpx;
  padding: 22rpx 22rpx 18rpx;
  margin-bottom: 20rpx;
  box-shadow: 6rpx 6rpx 0 #E8E0F8;
}

.ai-daily-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.ai-daily-icon { font-size: 24rpx; }

.ai-daily-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #6C5CE7;
}

.ai-daily-text {
  display: block;
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.ai-daily-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 2rpx dashed #E4E8EF;
  padding-top: 14rpx;
  gap: 10rpx;
}

.ai-stat {
  min-width: 0;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 14rpx;
  background: #F8FAFD;
}

.ai-stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #172033;
}

.ai-stat-label {
  display: block;
  font-size: 18rpx;
  color: #8A93A3;
  margin-top: 2rpx;
}

.roadmap {
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 22rpx;
  padding: 20rpx;
  margin-bottom: 22rpx;
  box-shadow: 6rpx 6rpx 0 #E5ECF5;
}

.roadmap-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.roadmap-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
  text-shadow: 3rpx 3rpx 0 #FFE4A8;
}

.roadmap-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #1677FF;
  background: #EAF3FF;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  border: 2rpx solid #1677FF;
}

.roadmap-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.roadmap-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  background: #F8FAFD;
  border: 2rpx solid #D8DFEA;
  border-radius: 14rpx;
}

.roadmap-item-icon { font-size: 24rpx; }

.roadmap-item-name {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #172033;
}

.roadmap-status {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid;
}

.rs-doing {
  color: #1677FF;
  background: #EAF3FF;
  border-color: #A8D4FF;
}

.rs-plan {
  color: #8A93A3;
  background: #F5F6FA;
  border-color: #E4E8EF;
}

.roadmap-footer {
  margin-top: 12rpx;
  text-align: center;
}

.roadmap-suggest {
  font-size: 22rpx;
  color: #6C5CE7;
  font-weight: 900;
}

.feed-section {
  margin-bottom: 18rpx;
}

.feed-section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.feed-section-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #172033;
  text-shadow: 3rpx 3rpx 0 #FFE4A8;
}

.filter-row {
  display: flex;
  gap: 8rpx;
}

.filter-tab {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #8A93A3;
  background: #FFFFFF;
  border: 2rpx solid #E4E8EF;
}

.filter-tab.active {
  background: #172033;
  color: #FFFFFF;
  border-color: #172033;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feed-card {
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 5rpx 5rpx 0 #E5ECF5;
}

.feed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.feed-user-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feed-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #EAF3FF;
  border: 2rpx solid #172033;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feed-initial {
  font-size: 22rpx;
  font-weight: 800;
  color: #1677FF;
}

.feed-user-info {
  display: flex;
  flex-direction: column;
}

.feed-nickname {
  font-size: 24rpx;
  font-weight: 700;
  color: #172033;
}

.feed-time {
  font-size: 20rpx;
  color: #8A93A3;
}

.feed-score-pill {
  display: flex;
  align-items: center;
  gap: 2rpx;
  background: #FFF7E8;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FFCF7A;
}

.feed-score-num {
  font-size: 22rpx;
  font-weight: 800;
  color: #B76A00;
}

.feed-score-star {
  font-size: 18rpx;
  color: #FFC107;
}

.feed-window-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 14rpx;
  background: #F8F9FB;
  border: 2rpx solid #E4E8EF;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.feed-window-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #1677FF;
}

.feed-window-arrow {
  font-size: 22rpx;
  color: #8A93A3;
}

.feed-content {
  margin-bottom: 10rpx;
}

.feed-text {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 1.55;
}

.feed-ai-tag {
  display: inline-flex;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #6C5CE7;
  background: #F0ECFF;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  border: 2rpx solid #D5CCFF;
}

.feed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.feed-tag {
  font-size: 20rpx;
  color: #697386;
  background: #F5F6FA;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E4E8EF;
}

.feed-footer {
  display: flex;
  gap: 24rpx;
  padding-top: 10rpx;
  border-top: 2rpx solid #F0F0F5;
}

.feed-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.action-icon {
  font-size: 22rpx;
}

.action-icon.liked { color: #E91E63; }

.action-count,
.action-text {
  font-size: 20rpx;
  color: #8A93A3;
}

.empty-tip {
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 24rpx;
  box-shadow: 7rpx 7rpx 0 #E5ECF5;
  text-align: center;
  padding: 54rpx 24rpx 34rpx;
}

.empty-emoji {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: #F8FAFD;
  border: 3rpx solid #172033;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  font-size: 52rpx;
  box-shadow: 5rpx 5rpx 0 #DCE7F5;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
  margin-bottom: 6rpx;
}

.empty-desc {
  display: block;
  font-size: 22rpx;
  color: #8A93A3;
  margin-bottom: 20rpx;
}

.empty-action {
  width: 210rpx;
  height: 58rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: #172033;
  color: #FFFFFF;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FFB020;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

/* Campus comic polish */
.feed-hero::after {
  content: 'NOTICE BOARD';
  position: absolute;
  right: 22rpx;
  top: 24rpx;
  height: 34rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  background: #FFB020;
  color: #172033;
  border: 2rpx solid #172033;
  border-radius: 8rpx;
  font-size: 16rpx;
  font-weight: 900;
  transform: rotate(6deg);
}

.bulletin-card {
  border-color: #172033;
  box-shadow: 4rpx 4rpx 0 #FFE4A8;
}

.quick-item:nth-child(1) { box-shadow: 5rpx 5rpx 0 #DCE7F5; }
.quick-item:nth-child(2) { box-shadow: 5rpx 5rpx 0 #FFE4A8; }
.quick-item:nth-child(3) { box-shadow: 5rpx 5rpx 0 #FFE0E0; }
.quick-item:nth-child(4) { box-shadow: 5rpx 5rpx 0 #E8E0F8; }

.ai-daily,
.roadmap,
.feed-card {
  position: relative;
  overflow: hidden;
}

.ai-daily::before,
.roadmap::before,
.feed-card::before {
  content: '';
  position: absolute;
  right: -28rpx;
  top: -28rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(255, 176, 32, 0.10);
}

.feed-card {
  box-shadow: 7rpx 7rpx 0 #E5ECF5;
}

.feed-window-row {
  background: #FFFDF7;
  border-color: #D8DFEA;
}

.feed-footer {
  border-top: 2rpx dashed #D8DFEA;
}

/* Pop art layer */
.feed-hero {
  background:
    radial-gradient(circle at 92% 16%, rgba(255, 79, 184, 0.18) 0 46rpx, transparent 48rpx),
    radial-gradient(circle at 18rpx 18rpx, rgba(0, 194, 255, 0.12) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);
}

.page-title-text,
.feed-section-title,
.roadmap-title {
  text-shadow: 3rpx 3rpx 0 #FFE14D, 6rpx 6rpx 0 rgba(255, 79, 184, 0.24);
}

.quick-icon,
.feed-avatar,
.empty-emoji {
  box-shadow: 4rpx 4rpx 0 #FFE14D;
}

.feed-card {
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(255, 79, 184, 0.08) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    #FFFFFF;
}

.feed-score-pill,
.feed-ai-tag,
.feed-tag {
  border-color: #172033;
  box-shadow: 3rpx 3rpx 0 rgba(0, 194, 255, 0.30);
}

.hero-burst {
  right: 22rpx;
  bottom: 20rpx;
}

.hero-chip {
  right: 110rpx;
  top: 76rpx;
}

.hero-zigzag {
  right: 34rpx;
  top: 128rpx;
  transform: rotate(-12deg);
}
