<view class="page">

  <view class="feed-hero">
    <view class="comic-dot dot-a"></view>
    <view class="comic-dot dot-b"></view>
    <view class="pop-burst hero-burst"><text>NEW!</text></view>
    <view class="campus-chip hero-chip">CAMPUS NEWS</view>
    <view class="pop-zigzag hero-zigzag"></view>
    <view class="page-title">
      <text class="page-kicker">校园信息入口</text>
      <text class="page-title-text">校园动态</text>
      <text class="page-title-sub">新鲜事不错过</text>
    </view>
  </view>

  <scroll-view class="bulletin-scroll" scroll-x enable-flex>
    <view class="bulletin-row">
      <view class="bulletin-card" wx:for="{{bulletins}}" wx:key="id">
        <text class="bulletin-icon">{{item.icon}}</text>
        <text class="bulletin-text">{{item.text}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="quick-row">
    <view class="quick-item" bindtap="goFeedback">
      <view class="quick-icon qi-blue">📝</view>
      <text class="quick-label">我要建议</text>
    </view>
    <view class="quick-item" bindtap="goLostFound">
      <view class="quick-icon qi-amber">🔍</view>
      <text class="quick-label">失物招领</text>
    </view>
    <navigator url="/pages/ranking/ranking" class="quick-item" open-type="switchTab">
      <view class="quick-icon qi-red">🏆</view>
      <text class="quick-label">美食榜单</text>
    </navigator>
    <view class="quick-item">
      <view class="quick-icon qi-purple">🤖</view>
      <text class="quick-label">AI助手</text>
    </view>
  </view>

  <view class="ai-daily">
    <view class="ai-daily-head">
      <text class="ai-daily-icon">🤖</text>
      <text class="ai-daily-title">AI 每日观察</text>
    </view>
    <text class="ai-daily-text">{{aiDaily}}</text>
    <view class="ai-daily-stats">
      <view class="ai-stat">
        <text class="ai-stat-num">{{todayStats.reviews}}</text>
        <text class="ai-stat-label">今日评价</text>
      </view>
      <view class="ai-stat">
        <text class="ai-stat-num">{{todayStats.likes}}</text>
        <text class="ai-stat-label">今日点赞</text>
      </view>
      <view class="ai-stat">
        <text class="ai-stat-num">{{todayStats.windows}}</text>
        <text class="ai-stat-label">活跃窗口</text>
      </view>
    </view>
  </view>

  <view class="roadmap">
    <view class="roadmap-head">
      <text class="roadmap-title">功能开发</text>
      <text class="roadmap-badge">路线图</text>
    </view>
    <view class="roadmap-list">
      <view class="roadmap-item" wx:for="{{devRoadmap}}" wx:key="name">
        <text class="roadmap-item-icon">{{item.icon}}</text>
        <text class="roadmap-item-name">{{item.name}}</text>
        <view class="roadmap-status {{item.status === 'doing' ? 'rs-doing' : 'rs-plan'}}">
          <text>{{item.status === 'doing' ? '开发中' : '规划中'}}</text>
        </view>
      </view>
    </view>
    <view class="roadmap-footer" bindtap="goFeedback">
      <text class="roadmap-suggest">你还想要什么功能？</text>
    </view>
  </view>

  <view class="feed-section">
    <view class="feed-section-head">
      <text class="feed-section-title">最新动态</text>
      <view class="filter-row">
        <view class="filter-tab {{filter === 'all' ? 'active' : ''}}" bindtap="switchFilter" data-filter="all">
          <text>全部</text>
        </view>
        <view class="filter-tab {{filter === 'hot' ? 'active' : ''}}" bindtap="switchFilter" data-filter="hot">
          <text>热门</text>
        </view>
        <view class="filter-tab {{filter === 'new' ? 'active' : ''}}" bindtap="switchFilter" data-filter="new">
          <text>最新</text>
        </view>
      </view>
    </view>

    <view class="feed-list" wx:if="{{filteredActivities.length > 0}}">
      <view
        class="feed-card"
        wx:for="{{filteredActivities}}"
        wx:key="id"
      >
        <view class="feed-header">
          <view class="feed-user-row">
            <view class="feed-avatar">
              <text class="feed-initial">{{item.userInitial || '匿'}}</text>
            </view>
            <view class="feed-user-info">
              <text class="feed-nickname">{{item.nickname || '匿名同学'}}</text>
              <text class="feed-time">{{item.timeLabel}}</text>
            </view>
          </view>
          <view class="feed-score-pill">
            <text class="feed-score-num">{{item.score}}</text>
            <text class="feed-score-star">★</text>
          </view>
        </view>

        <view class="feed-window-row" bindtap="goToDetail" data-id="{{item.windowId}}">
          <text class="feed-window-name">{{item.windowName}}</text>
          <text class="feed-window-arrow">→</text>
        </view>

        <view class="feed-content">
          <text class="feed-text">{{item.text}}</text>
          <view class="feed-ai-tag" wx:if="{{item.hasRewrite}}">
            <text>✨ AI优化</text>
          </view>
        </view>

        <view class="feed-tags" wx:if="{{item.aiTags && item.aiTags.length > 0}}">
          <text class="feed-tag" wx:for="{{item.aiTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>

        <view class="feed-footer">
          <view class="feed-action" bindtap="onLike" data-id="{{item.id}}">
            <text class="action-icon {{item.likeCount > 0 ? 'liked' : ''}}">♥</text>
            <text class="action-count">{{item.likeCount}}</text>
          </view>
          <view class="feed-action" bindtap="goToDetail" data-id="{{item.windowId}}">
            <text class="action-icon">💬</text>
            <text class="action-text">评论</text>
          </view>
          <view class="feed-action">
            <text class="action-icon">↗️</text>
            <text class="action-text">分享</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{filteredActivities.length === 0 && !loading}}">
      <view class="empty-emoji">📡</view>
      <text class="empty-title">暂无动态</text>
      <text class="empty-desc">{{activities.length === 0 ? '同学们还没开始评价呢' : '当前筛选下还没有内容'}}</text>
      <view class="empty-action" bindtap="goFeedback">发布第一条</view>
    </view>
  </view>

</view>
