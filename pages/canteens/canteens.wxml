<view class="container">
  <view class="banner-section top-banner">
    <swiper
      class="banner-swiper"
      autoplay
      circular
      interval="3500"
      duration="500"
      indicator-dots
      indicator-color="rgba(255,255,255,0.55)"
      indicator-active-color="#FFFFFF"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-item" bindtap="onBannerTap" data-id="{{item.id}}">
          <image class="banner-img" src="{{item.image}}" mode="aspectFill" />
          <view class="banner-mask"></view>
          <view class="banner-copy">
            <text class="banner-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
            <text class="banner-title">{{item.title || '校园美食推荐'}}</text>
            <text class="banner-desc">{{item.desc || '发现近期同学关注的好味道'}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="hero">
    <view class="comic-dot dot-a"></view>
    <view class="comic-dot dot-b"></view>
    <view class="pop-burst hero-burst"><text>WOW!</text></view>
    <view class="campus-chip hero-chip">CAMPUS FOOD</view>
    <view class="pop-zigzag hero-zigzag"></view>
    <view class="hero-top">
      <view>
        <text class="greeting">校园干饭时间 · {{greeting}}</text>
        <text class="hero-title">今天想吃点什么？</text>
      </view>
      <view class="hero-action" bindtap="goToRanking">TOP榜</view>
    </view>

    <view class="search-card" bindtap="goSearch">
      <text class="search-icon">⌕</text>
      <text class="search-placeholder">搜索窗口、菜品、食堂</text>
    </view>

    <view class="meal-chips">
      <view class="meal-chip meal-chip-hot">饭点推荐</view>
      <view class="meal-chip">15元以内</view>
      <view class="meal-chip">出餐快</view>
      <view class="meal-chip">同学好评</view>
    </view>

    <view class="stat-panel">
      <view class="stat-item">
        <text class="stat-num">{{canteens.length}}</text>
        <text class="stat-label">食堂</text>
      </view>
      <view class="stat-line"></view>
      <view class="stat-item">
        <text class="stat-num">{{totalWindows}}</text>
        <text class="stat-label">窗口</text>
      </view>
      <view class="stat-line"></view>
      <view class="stat-item">
        <text class="stat-num">{{totalReviews}}</text>
        <text class="stat-label">评价</text>
      </view>
    </view>
  </view>

  <view class="quick-row">
    <view class="quick-card" bindtap="goToWindows" data-id="1">
      <view class="sticker-bang">HOT</view>
      <view class="quick-icon quick-blue">热</view>
      <text class="quick-title">热门窗口</text>
      <text class="quick-desc">快速找好吃的</text>
      <view class="quick-pattern"></view>
    </view>
    <view class="quick-card" bindtap="goToFeedback">
      <view class="sticker-bang sticker-green">NEW</view>
      <view class="quick-icon quick-green">评</view>
      <text class="quick-title">写评价</text>
      <text class="quick-desc">分享真实体验</text>
      <view class="quick-pattern"></view>
    </view>
    <navigator url="/pages/lost-found/lost-found" class="quick-card">
      <view class="sticker-bang sticker-amber">HELP</view>
      <view class="quick-icon quick-amber">寻</view>
      <text class="quick-title">失物招领</text>
      <text class="quick-desc">校园互助</text>
      <view class="quick-pattern"></view>
    </navigator>
  </view>

  <view class="today-strip" bindtap="goToFeedback">
    <view class="today-main">
      <text class="today-kicker">AI 美食灵感</text>
      <text class="today-title">不知道吃什么？让同学评价帮你选</text>
    </view>
    <view class="today-btn">开吃</view>
  </view>

  <view class="section-head">
    <text class="section-title">菜品分类</text>
    <text class="section-more">全部</text>
  </view>
  <view class="category-grid">
    <view
      class="category-card"
      wx:for="{{dishCategories}}"
      wx:key="id"
      bindtap="goCategory"
      data-id="{{item.id}}"
    >
      <view class="category-img-box">
        <image class="category-img category-img-{{item.id}}" src="{{item.image}}" mode="aspectFill" />
      </view>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">推荐窗口</text>
    <text class="section-more" bindtap="goToRanking">查看榜单</text>
  </view>
  <view class="recommend-list" wx:if="{{topWindows.length > 0}}">
    <view
      class="recommend-card"
      wx:for="{{topWindows}}"
      wx:key="id"
      bindtap="goWindowDetail"
      data-id="{{item.id}}"
    >
      <view class="rank-pill">TOP {{index + 1}}</view>
      <view class="recommend-main">
        <text class="recommend-name">{{item.name}}</text>
        <text class="recommend-location">{{item.location}}</text>
        <text class="recommend-copy">{{recommendTexts[index] || '近期同学关注较多的窗口'}}</text>
      </view>
      <view class="score-box">
        <text class="score-num">{{item.totalScore}}</text>
        <text class="score-label">评分</text>
      </view>
    </view>
  </view>
  <view class="empty-recommend" wx:else>
    <view class="empty-pop">HEY!</view>
    <view class="empty-flash flash-a"></view>
    <view class="empty-flash flash-b"></view>
    <view class="empty-plate">
      <text class="empty-icon">🍱</text>
    </view>
    <view class="empty-main">
      <text class="empty-title">还没有推荐窗口</text>
      <text class="empty-desc">发布第一条评价后会自动生成推荐</text>
    </view>
    <view class="empty-cta" bindtap="goToFeedback">去评价</view>
  </view>

  <view class="section-head">
    <text class="section-title">全部食堂</text>
    <text class="section-more">{{canteens.length}} 家</text>
  </view>
  <skeleton loading="{{loading}}" type="list" rows="{{3}}">
    <view class="canteen-list">
      <view
        class="canteen-card"
        wx:for="{{canteens}}"
        wx:key="id"
        bindtap="goToWindows"
        data-id="{{item.id}}"
      >
        <view class="canteen-ribbon">NO.{{index + 1}}</view>
        <view class="canteen-bang">OPEN</view>
        <view class="speed-lines"></view>
        <view class="canteen-mark canteen-mark-{{index % 3}}">{{item.name[0]}}</view>
        <view class="canteen-info">
          <view class="canteen-title-row">
            <text class="canteen-name">{{item.name}}</text>
            <text class="canteen-tag">开放中</text>
          </view>
          <text class="canteen-desc">{{item.desc}}</text>
          <view class="canteen-meta">
            <text class="meta-pill">🏫 {{item.floors}} 层</text>
            <text class="meta-pill meta-hot">🍽 {{item.windowCount || 0}} 个窗口</text>
            <text class="meta-pill meta-pop">POP!</text>
          </view>
        </view>
        <view class="canteen-action">
          <text class="canteen-action-text">GO</text>
          <text class="canteen-arrow">›</text>
        </view>
      </view>
    </view>
  </skeleton>
</view>
