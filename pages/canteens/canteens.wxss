.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(22, 119, 255, 0.07) 0 4rpx, transparent 5rpx) 0 390rpx / 34rpx 34rpx,
    linear-gradient(180deg, #FFF8E8 0%, #F7F8FA 440rpx),
    #F7F8FA;
  padding: 0 24rpx 200rpx;
  box-sizing: border-box;
}

.hero {
  position: relative;
  z-index: 3;
  margin: 18rpx 0 24rpx;
  padding: 28rpx 26rpx 24rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(255, 176, 32, 0.18) 0 38rpx, transparent 40rpx),
    linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);
  border: 4rpx solid #172033;
  border-radius: 28rpx;
  box-shadow: 10rpx 10rpx 0 #DCE7F5;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(22, 119, 255, 0.08);
}

.hero::after {
  content: '';
  position: absolute;
  left: -44rpx;
  bottom: -56rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255, 176, 32, 0.10);
}

.comic-dot {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.dot-a {
  width: 18rpx;
  height: 18rpx;
  left: 34rpx;
  top: 24rpx;
  background: #FFB020;
  box-shadow: 28rpx 10rpx 0 rgba(255, 176, 32, 0.55), 12rpx 38rpx 0 rgba(22, 119, 255, 0.36);
}

.dot-b {
  width: 12rpx;
  height: 12rpx;
  right: 56rpx;
  bottom: 38rpx;
  background: rgba(34, 160, 107, 0.35);
  box-shadow: 24rpx -18rpx 0 rgba(34, 160, 107, 0.22), -18rpx -28rpx 0 rgba(22, 119, 255, 0.18);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.greeting {
  display: block;
  font-size: 24rpx;
  color: #6B4E16;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #172033;
  text-shadow: 3rpx 3rpx 0 #FFE4A8;
}

.hero-action {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #172033;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FFB020;
}

.search-card {
  position: relative;
  z-index: 1;
  height: 76rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 6rpx 6rpx 0 #EAF3FF;
  margin-bottom: 16rpx;
}

.search-icon {
  width: 42rpx;
  font-size: 34rpx;
  color: #8A93A3;
  line-height: 1;
}

.search-placeholder {
  font-size: 26rpx;
  color: #8A93A3;
}

.meal-chips {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 10rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.meal-chip {
  flex-shrink: 0;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  color: #697386;
  border: 2rpx solid #D8DFEA;
  font-size: 21rpx;
  font-weight: 600;
}

.meal-chip-hot {
  background: #FFF7E8;
  color: #B76A00;
  border-color: #FFCF7A;
}

.stat-panel {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 20rpx;
  padding: 22rpx 0;
  box-shadow: 6rpx 6rpx 0 #F0F4FA;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
  color: #1677FF;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A93A3;
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: #EEF2F7;
}

.banner-section {
  margin-bottom: 28rpx;
}

.top-banner {
  margin: 0 -24rpx 24rpx;
  padding: 0;
  background: #172033;
}

.banner-swiper {
  height: 392rpx;
  border-radius: 0 0 30rpx 30rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(22, 31, 46, 0.08);
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 0 0 30rpx 30rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 16% 18%, rgba(255, 176, 32, 0.30) 0 6rpx, transparent 7rpx) 0 0 / 42rpx 42rpx,
    linear-gradient(180deg, rgba(23, 32, 51, 0.24) 0%, rgba(23, 32, 51, 0.06) 38%, rgba(23, 32, 51, 0.72) 100%),
    linear-gradient(90deg, rgba(23, 32, 51, 0.38) 0%, rgba(23, 32, 51, 0.10) 62%, rgba(23, 32, 51, 0.04) 100%);
}

.banner-copy {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 78rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.banner-tag {
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: #FFF7E8;
  color: #172033;
  font-size: 20rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  border: 2rpx solid #172033;
}

.banner-title {
  font-size: 34rpx;
  line-height: 1.25;
  color: #FFFFFF;
  font-weight: 800;
  margin-bottom: 6rpx;
  text-shadow: 3rpx 3rpx 0 rgba(23, 32, 51, 0.58);
}

.banner-desc {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.82);
}

.quick-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.quick-card {
  position: relative;
  min-width: 0;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 6rpx 6rpx 0 #E5ECF5;
  overflow: hidden;
}

.quick-card:active,
.category-card:active,
.recommend-card:active,
.canteen-card:active {
  transform: scale(0.99);
}

.quick-icon {
  position: relative;
  z-index: 1;
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.quick-blue { background: #1677FF; }
.quick-green { background: #22A06B; }
.quick-amber { background: #FFB020; }

.sticker-bang {
  position: absolute;
  top: 12rpx;
  right: 10rpx;
  z-index: 2;
  height: 30rpx;
  padding: 0 9rpx;
  border-radius: 8rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  font-size: 16rpx;
  font-weight: 900;
  transform: rotate(6deg);
}

.sticker-green {
  background: #22A06B;
}

.sticker-amber {
  background: #FFB020;
  color: #172033;
}

.quick-title {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  line-height: 1.25;
  color: #172033;
  font-weight: 750;
  margin-bottom: 6rpx;
}

.quick-desc {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  color: #8A93A3;
  white-space: nowrap;
}

.quick-pattern {
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  background: rgba(22, 119, 255, 0.06);
}

.quick-card:nth-child(2) .quick-pattern {
  background: rgba(34, 160, 107, 0.07);
}

.quick-card:nth-child(3) .quick-pattern {
  background: rgba(255, 176, 32, 0.10);
}

.today-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 92% 18%, rgba(255, 176, 32, 0.30) 0 28rpx, transparent 30rpx),
    linear-gradient(135deg, #172033 0%, #253B5C 100%);
  border: 4rpx solid #172033;
  box-shadow: 8rpx 8rpx 0 #FFB020;
  margin-bottom: 28rpx;
}

.today-main {
  min-width: 0;
}

.today-kicker {
  display: block;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.62);
  margin-bottom: 6rpx;
}

.today-title {
  display: block;
  font-size: 27rpx;
  color: #FFFFFF;
  font-weight: 750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-btn {
  flex-shrink: 0;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #172033;
  font-size: 23rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  border: 2rpx solid #172033;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #172033;
  text-shadow: 3rpx 3rpx 0 #FFE4A8;
}

.section-more {
  font-size: 24rpx;
  color: #8A93A3;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.category-card {
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 20rpx;
  min-height: 154rpx;
  padding: 8rpx 8rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 5rpx 5rpx 0 #E5ECF5;
}

.category-img-box {
  width: 126rpx;
  height: 108rpx;
  border-radius: 0;
  overflow: hidden;
  background: transparent;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #F1F4F8;
  transform: scale(1.06);
}

.category-img-drink {
  transform: scale(1);
}

.category-name {
  display: block;
  margin-top: 6rpx;
  text-align: center;
  font-size: 23rpx;
  color: #475569;
  font-weight: 650;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommend-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 7rpx 7rpx 0 #E5ECF5;
}

.rank-pill {
  width: 78rpx;
  height: 42rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF7E8;
  color: #B76A00;
  border: 2rpx solid #172033;
  font-size: 20rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.recommend-main {
  flex: 1;
  min-width: 0;
}

.recommend-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #172033;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-location,
.recommend-copy {
  display: block;
  font-size: 22rpx;
  color: #8A93A3;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-copy {
  color: #697386;
  margin-top: 4rpx;
}

.score-box {
  width: 86rpx;
  height: 86rpx;
  border-radius: 20rpx;
  background: #EAF3FF;
  border: 3rpx solid #172033;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.score-num {
  font-size: 30rpx;
  line-height: 1;
  color: #1677FF;
  font-weight: 800;
}

.score-label {
  font-size: 18rpx;
  color: #6B93D6;
  margin-top: 6rpx;
}

.empty-recommend {
  position: relative;
  background:
    repeating-linear-gradient(-12deg, rgba(255, 225, 77, 0.18) 0 10rpx, transparent 10rpx 22rpx),
    radial-gradient(circle at 18rpx 18rpx, rgba(255, 79, 184, 0.08) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 24rpx;
  padding: 22rpx 20rpx 22rpx 126rpx;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 8rpx 8rpx 0 #FF4FB8;
  overflow: visible;
}

.empty-pop {
  position: absolute;
  left: 22rpx;
  top: -16rpx;
  height: 34rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  background: #FF4FB8;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  border-radius: 8rpx;
  font-size: 16rpx;
  font-weight: 900;
  transform: rotate(-6deg);
}

.empty-plate {
  position: absolute;
  left: 24rpx;
  top: 28rpx;
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: #FFF7E8;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #00C2FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 40rpx;
}

.empty-flash {
  position: absolute;
  width: 64rpx;
  height: 16rpx;
  background: #00C2FF;
  border: 2rpx solid #172033;
  box-shadow: 3rpx 3rpx 0 #FFE14D;
  transform: skewX(-24deg) rotate(-8deg);
}

.flash-a {
  right: 120rpx;
  top: 18rpx;
}

.flash-b {
  right: 74rpx;
  bottom: 18rpx;
  width: 46rpx;
  background: #FF4FB8;
}

.empty-main {
  flex: 1;
  min-width: 0;
}

.empty-title {
  font-size: 30rpx;
  color: #172033;
  font-weight: 900;
  margin-bottom: 8rpx;
  text-shadow: 2rpx 2rpx 0 #FFE14D;
}

.empty-desc {
  font-size: 21rpx;
  color: #8A93A3;
  line-height: 1.35;
}

.empty-cta {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #172033;
  color: #FFFFFF;
  border: 3rpx solid #172033;
  box-shadow: 4rpx 4rpx 0 #FF4FB8;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 900;
}

.canteen-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.canteen-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 3rpx solid #172033;
  border-radius: 24rpx;
  padding: 22rpx 18rpx 18rpx;
  box-shadow: 7rpx 7rpx 0 #E5ECF5;
  overflow: visible;
  min-height: 128rpx;
}

.canteen-card:nth-child(3n + 1) { box-shadow: 8rpx 8rpx 0 #DCE7F5; }
.canteen-card:nth-child(3n + 2) { box-shadow: 8rpx 8rpx 0 #DDF3E8; }
.canteen-card:nth-child(3n) { box-shadow: 8rpx 8rpx 0 #FFE4A8; }

.canteen-ribbon {
  position: absolute;
  right: 38rpx;
  top: -14rpx;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #FFE14D;
  color: #172033;
  border: 2rpx solid #172033;
  box-shadow: 3rpx 3rpx 0 #FF4FB8;
  display: flex;
  align-items: center;
  font-size: 15rpx;
  font-weight: 900;
  transform: rotate(4deg);
}

.canteen-bang {
  position: absolute;
  left: 92rpx;
  top: -12rpx;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #00C2FF;
  color: #FFFFFF;
  border: 2rpx solid #172033;
  box-shadow: 3rpx 3rpx 0 #FFE14D;
  display: flex;
  align-items: center;
  font-size: 14rpx;
  font-weight: 900;
  transform: rotate(-5deg);
}

.speed-lines {
  position: absolute;
  right: 92rpx;
  top: 42rpx;
  width: 86rpx;
  height: 46rpx;
  background:
    linear-gradient(90deg, #172033 0 28rpx, transparent 28rpx) 0 0 / 86rpx 6rpx,
    linear-gradient(90deg, #172033 0 54rpx, transparent 54rpx) 0 18rpx / 86rpx 6rpx,
    linear-gradient(90deg, #172033 0 36rpx, transparent 36rpx) 0 36rpx / 86rpx 6rpx;
  opacity: 0.12;
  pointer-events: none;
}

.canteen-mark {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 900;
  flex-shrink: 0;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FFE14D;
}

.canteen-mark-0 { background: #1677FF; }
.canteen-mark-1 { background: #22A06B; }
.canteen-mark-2 { background: #FFB020; }

.canteen-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.canteen-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.canteen-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #172033;
  text-shadow: 2rpx 2rpx 0 rgba(255, 225, 77, 0.75);
}

.canteen-tag {
  height: 30rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: #EAF7F0;
  color: #1F8A4C;
  font-size: 18rpx;
  font-weight: 900;
  border: 2rpx solid #172033;
  box-shadow: 3rpx 3rpx 0 rgba(0, 194, 255, 0.28);
}

.canteen-desc {
  display: block;
  font-size: 23rpx;
  color: #697386;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.canteen-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.meta-pill {
  height: 30rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  background: #EAF3FF;
  color: #1677FF;
  border: 2rpx solid #172033;
  display: flex;
  align-items: center;
  font-size: 17rpx;
  font-weight: 900;
  box-shadow: 2rpx 2rpx 0 rgba(0, 194, 255, 0.35);
}

.meta-hot {
  background: #FFF7E8;
  color: #8B5E00;
  box-shadow: 2rpx 2rpx 0 rgba(255, 79, 184, 0.35);
}

.meta-pop {
  background: #FF4FB8;
  color: #FFFFFF;
  transform: rotate(-3deg);
  box-shadow: 2rpx 2rpx 0 #FFE14D;
}

.canteen-action {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #172033;
  border: 3rpx solid #172033;
  box-shadow: 5rpx 5rpx 0 #FF4FB8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.canteen-action-text {
  font-size: 16rpx;
  line-height: 1;
  color: #FFE14D;
  font-weight: 900;
}

.canteen-arrow {
  color: #FFFFFF;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
}

/* Campus comic polish */
.container::before {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 408rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(23, 32, 51, 0.08);
}

.banner-swiper {
  border-bottom: 5rpx solid #172033;
}

.banner-copy::before {
  content: 'CAMPUS';
  display: inline-flex;
  height: 32rpx;
  padding: 0 10rpx;
  align-items: center;
  margin-bottom: 10rpx;
  background: #FFB020;
  color: #172033;
  border: 2rpx solid #172033;
  border-radius: 8rpx;
  font-size: 17rpx;
  font-weight: 900;
  transform: rotate(-4deg);
}

.hero,
.quick-card,
.today-strip,
.category-card,
.recommend-card,
.canteen-card {
  transition: transform 0.16s ease;
}

.hero {
  box-shadow: 12rpx 12rpx 0 #DCE7F5;
}

.quick-card:nth-child(1) { box-shadow: 6rpx 6rpx 0 #DCE7F5; }
.quick-card:nth-child(2) { box-shadow: 6rpx 6rpx 0 #DDF3E8; }
.quick-card:nth-child(3) { box-shadow: 6rpx 6rpx 0 #FFE4A8; }

.category-card {
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 176, 32, 0.12) 0 24rpx, transparent 26rpx),
    #FFFFFF;
}

.category-img-box {
  border-radius: 18rpx;
  border: 2rpx solid #D8DFEA;
  background: #F8FAFD;
}

.recommend-card::after,
.canteen-card::after {
  content: '';
  position: absolute;
  width: 44rpx;
  height: 16rpx;
  right: 24rpx;
  top: -8rpx;
  background: rgba(255, 176, 32, 0.78);
  border: 2rpx solid #172033;
  transform: rotate(4deg);
}

.canteen-card {
  position: relative;
}

/* Pop art layer */
.hero::before,
.feed-hero::before,
.report-hero::before {
  background: rgba(255, 79, 184, 0.10);
}

.banner-mask {
  background:
    radial-gradient(circle at 16% 18%, rgba(255, 225, 77, 0.48) 0 5rpx, transparent 6rpx) 0 0 / 30rpx 30rpx,
    linear-gradient(180deg, rgba(23, 32, 51, 0.16) 0%, rgba(23, 32, 51, 0.06) 38%, rgba(23, 32, 51, 0.70) 100%),
    linear-gradient(90deg, rgba(255, 79, 184, 0.22) 0%, rgba(0, 194, 255, 0.10) 62%, transparent 100%);
}

.hero {
  background:
    radial-gradient(circle at 90% 14%, rgba(255, 79, 184, 0.18) 0 44rpx, transparent 46rpx),
    radial-gradient(circle at 20% 78%, rgba(0, 194, 255, 0.12) 0 36rpx, transparent 38rpx),
    linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);
}

.hero-title,
.section-title {
  text-shadow: 3rpx 3rpx 0 #FFE14D, 6rpx 6rpx 0 rgba(255, 79, 184, 0.22);
}

.hero-action,
.today-btn,
.rank-pill,
.canteen-tag,
.sticker-bang {
  box-shadow: 4rpx 4rpx 0 #00C2FF;
}

.quick-icon,
.canteen-mark,
.score-box {
  box-shadow: 4rpx 4rpx 0 #FFE14D;
}

.quick-card,
.category-card,
.recommend-card,
.canteen-card {
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(0, 194, 255, 0.10) 0 4rpx, transparent 5rpx) 0 0 / 30rpx 30rpx,
    #FFFFFF;
}

.hero-burst {
  right: 24rpx;
  top: 22rpx;
}

.hero-chip {
  right: 112rpx;
  top: 116rpx;
}

.hero-zigzag {
  right: 20rpx;
  bottom: 28rpx;
  transform: rotate(-12deg);
}

.hero-top {
  padding-right: 142rpx;
}
