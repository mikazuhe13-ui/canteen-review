.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 图片轮播 */
.image-swiper {
  height: 480rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

/* 状态横幅 */
.status-banner {
  padding: 16rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.status-banner.open { background: #FFF3E0; color: #E65100; }
.status-banner.resolved { background: #E8F5E9; color: #2E7D32; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.type-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.type-badge.lost { background: #FFF3E0; color: #E65100; }
.type-badge.found { background: #E8F5E9; color: #2E7D32; }

.item-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.item-desc {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  font-size: 22rpx;
  color: #E65100;
  background: #FFF3E0;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

/* 发布者 */
.publisher-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.publisher-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.publisher-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 联系方式 */
.contact-card {
  border-left: 6rpx solid #E65100;
}

.contact-title {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.contact-value {
  font-size: 30rpx;
  color: #E65100;
  font-weight: 600;
}

/* 操作按钮 */
.action-bar {
  margin: 24rpx;
}

.action-btn {
  border: none;
  border-radius: 20rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.resolve-btn {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;
}

.reopen-btn {
  background: #FFF3E0;
  color: #E65100;
}

/* 匹配推荐 */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.match-item:last-child { border-bottom: none; }

.match-type-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.match-type-badge.lost { background: #FFF3E0; color: #E65100; }
.match-type-badge.found { background: #E8F5E9; color: #2E7D32; }

.match-body { flex: 1; min-width: 0; }
.match-title { display: block; font-size: 26rpx; font-weight: 600; color: #333; }
.match-meta { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }

.match-score {
  font-size: 20rpx;
  color: #4CAF50;
  background: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
