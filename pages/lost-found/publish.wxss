.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

/* 类型选择 */
.type-row {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eee;
  transition: all 0.2s;
}

.type-option.active {
  border-color: #E65100;
  background: #FFF3E0;
}

.type-emoji { font-size: 40rpx; }
.type-label { font-size: 26rpx; color: #666; font-weight: 500; }
.type-option.active .type-label { color: #E65100; }

/* 分类选择 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: calc(25% - 12rpx);
  padding: 20rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #eee;
  transition: all 0.2s;
}

.category-option.active {
  border-color: #E65100;
  background: #FFF3E0;
}

.cat-emoji { font-size: 36rpx; }
.cat-name { font-size: 22rpx; color: #666; }
.category-option.active .cat-name { color: #E65100; font-weight: 600; }

/* 图片上传 */
.photo-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-add-icon { font-size: 48rpx; color: #ccc; }
.photo-add-text { font-size: 22rpx; color: #999; }

.ai-identify {
  margin-top: 16rpx;
}

.ai-btn {
  background: linear-gradient(135deg, #E65100, #FF6D00);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.ai-btn-small {
  background: #FFF3E0;
  color: #E65100;
  border: none;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  margin-top: 12rpx;
}

.ai-result {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #FFF3E0;
  border-radius: 12rpx;
}

.ai-result-label {
  font-size: 22rpx;
  color: #E65100;
  font-weight: 600;
}

.ai-result-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

/* 表单 */
.form-input {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-textarea {
  font-size: 28rpx;
  color: #333;
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.ai-generate {
  margin-top: 8rpx;
}

/* 提交按钮 */
.submit-wrap {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #E65100, #FF6D00);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(230, 81, 0, 0.2);
}
