.tabbar {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 999;
  height: 118rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(255, 176, 32, 0.15) 0 4rpx, transparent 5rpx) 0 0 / 34rpx 34rpx,
    rgba(255, 255, 255, 0.98);
  border: 3rpx solid #172033;
  border-radius: 32rpx;
  box-shadow: 0 -8rpx 24rpx rgba(23, 32, 51, 0.08), 7rpx 7rpx 0 #DCE7F5;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.icon-wrap {
  width: 76rpx;
  height: 70rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.18s ease, transform 0.18s ease;
}

.icon-wrap-on {
  background: #FFF7E8;
  border: 3rpx solid #172033;
  box-shadow: 4rpx 4rpx 0 #FFB020;
  transform: rotate(-3deg) translateY(-4rpx);
}

.tab-icon {
  width: 58rpx;
  height: 58rpx;
  transition: filter 0.18s ease, transform 0.18s ease;
  filter: grayscale(1) brightness(0.72) contrast(1.18) opacity(0.82);
}

.on .tab-icon {
  filter: none;
  transform: scale(1.08);
}

.tab-txt {
  font-size: 21rpx;
  line-height: 1.2;
  color: #6F7782;
  font-weight: 700;
}

.tab-txt-on {
  color: #172033;
  font-weight: 900;
}
