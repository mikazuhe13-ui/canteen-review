page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
}

.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #888;
}

.btn-primary {
  background: linear-gradient(135deg, #6C5CE7, #5B7FFF);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.2);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 28rpx;
  padding-left: 8rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

.badge {
  display: inline-block;
  background: #F0EDFF;
  color: #6C5CE7;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}
